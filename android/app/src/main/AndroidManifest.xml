<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Automatic daily SMS reminders (10:00 AM): the sent-result
             receiver and the exact-alarm receiver only ever hear this
             app's own broadcasts; the boot receiver re-arms the 10:00
             alarm after a reboot (exact alarms do not survive one). -->
        <receiver
            android:name=".SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aurum.jewellery.SMS_SENT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".SmsAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aurum.jewellery.SMS_REMINDER_ALARM" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".SmsBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Automatic daily backup (02:00 AM): same pattern as the
             10:00 AM SMS reminders — the exact-alarm receiver re-arms
             tomorrow's alarm, the boot receiver re-arms it after a
             reboot (exact alarms do not survive one). -->
        <receiver
            android:name=".BackupAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aurum.jewellery.AUTO_BACKUP_ALARM" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".BackupBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One-tap in-app update: installing the downloaded APK needs
         this, plus the shopkeeper allowing "Install unknown apps"
         for Aurum once in Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Automatic SMS reminders: sent from the shopkeeper's own SIM. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 10:00 AM exact alarm (Android 12+); the shopkeeper grants it
         in Settings → "Alarms & reminders". Without it the reminder
         falls back to WorkManager periodic work (best-effort). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
